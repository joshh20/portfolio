---
---

<div class="relative" id="theme-dropdown">
  <button
    id="theme-toggle"
    class="rounded-full bg-slate-50 p-2 text-slate-500 dark:bg-slate-900 dark:text-slate-400"
    aria-label="Switch theme color mode"
  >
    <!-- Sun icon: visible in light mode, hidden in dark mode -->
    <svg
      class="h-6 w-auto sm:h-8 dark:hidden"
      fill="none"
      stroke-width="1.5"
      stroke="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
      ></path>
    </svg>
    <!-- Moon icon: visible in dark mode, hidden in light mode -->
    <svg
      class="hidden h-6 w-auto sm:h-8 dark:block"
      fill="none"
      stroke-width="1.5"
      stroke="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
      ></path>
    </svg>
  </button>
  <div
    id="theme-menu"
    class="absolute -left-[5rem] top-16 z-10 hidden w-32 rounded-md bg-slate-50 py-2 text-slate-500 shadow-xl outline outline-1 outline-gray-300 dark:bg-slate-900 dark:text-slate-400 dark:outline-gray-700 sm:-left-10"
  >
    <button
      data-theme="light"
      class="block w-full cursor-pointer px-4 py-2 text-sm hover:bg-slate-200 hover:dark:bg-slate-800"
    >
      Light theme
    </button>
    <button
      data-theme="dark"
      class="block w-full cursor-pointer px-4 py-2 text-sm hover:bg-slate-200 hover:dark:bg-slate-800"
    >
      Dark theme
    </button>
    <button
      data-theme="system"
      class="block w-full cursor-pointer px-4 py-2 text-sm hover:bg-slate-200 hover:dark:bg-slate-800"
    >
      System theme
    </button>
  </div>
</div>

<script>
  function setupThemeDropdown() {
    const toggle = document.getElementById("theme-toggle");
    const menu = document.getElementById("theme-menu");
    if (!toggle || !menu) return;

    function getResolvedTheme(theme: string): "light" | "dark" {
      if (theme === "system") {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }
      return theme as "light" | "dark";
    }

    function applyTheme(theme: string) {
      localStorage.setItem("theme", theme);
      const isDark = getResolvedTheme(theme) === "dark";
      document.documentElement.classList.toggle("dark", isDark);
    }

    // Toggle dropdown
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    // Theme selection buttons
    menu.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.dataset.theme!;
        applyTheme(theme);
        menu.classList.add("hidden");
      });
    });

    // Close on outside click
    document.addEventListener("mousedown", (e) => {
      const dropdown = document.getElementById("theme-dropdown");
      if (dropdown && !dropdown.contains(e.target as Node)) {
        menu.classList.add("hidden");
      }
    });

    // Listen for system preference changes
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        const theme = localStorage.getItem("theme") || "system";
        if (theme === "system") {
          applyTheme("system");
        }
      });
  }

  setupThemeDropdown();
  document.addEventListener("astro:after-swap", setupThemeDropdown);
</script>
