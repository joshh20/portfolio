---
import { configData } from "@/assets/configData";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title=`${configData.name.first} ${configData.name.last} - 404 Not Found`
>
  <div class="mx-4">
    <div
      class="mx-auto mt-4 max-w-xl rounded-lg bg-slate-50 p-4 text-center text-slate-800 drop-shadow-xl duration-500 dark:bg-slate-900 dark:text-slate-300 sm:mt-8 sm:p-8"
    >
      <h1 class="mb-4 text-xl sm:mb-8 sm:text-3xl">
        Sorry, the page you were looking for was not found.
      </h1>
      <a
        href="/"
        class="inline-block rounded-lg border-2 border-gray-300 bg-transparent px-2 py-1 ring-gray-300 hover:font-bold hover:ring-2 hover:ring-offset-2 dark:border-gray-700 dark:bg-transparent dark:ring-gray-200 dark:hover:ring-2 dark:hover:ring-offset-2 sm:text-lg"
      >
        Return Home
      </a>
    </div>
  </div>
</Layout>
