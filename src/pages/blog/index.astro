---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import RelativeTime from "@/components/RelativeTime.tsx";
import { getCollection } from "astro:content";
import { configData } from "@/assets/configData";

const blogs = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<Layout
  title={`${configData.name.first} ${configData.name.last} - ${configData.pages.blogPage.header}`}
>
  <PageHeader title={configData.pages.blogPage.header} />
  {
    blogs.map((blog) => (
      <div class="mb-4 last:mb-0 sm:mb-8">
        <a href={`/blog/${blog.id}`}>
          <article class="grid rounded-md bg-slate-200/10 p-4 text-slate-800 shadow-md dark:bg-slate-900 dark:text-slate-300 sm:grid-cols-6 sm:p-8">
            <div class="col-span-4">
              <h3 class="mb-3 text-xl font-bold">{blog.data.title}</h3>
              <h4 class="mb-3 font-bold sm:hidden">
                Posted <RelativeTime date={blog.data.date} client:load />
              </h4>
              <p>{blog.data.description}</p>
            </div>
            <div class="col-span-2 hidden justify-self-end font-bold sm:inline-block">
              <RelativeTime date={blog.data.date} client:load />
            </div>
          </article>
        </a>
      </div>
    ))
  }
</Layout>
